# Copier en .env puis adapter.

# --- PostgreSQL (service `db` de docker-compose) ---
POSTGRES_USER=getiajob
POSTGRES_PASSWORD=getiajob
POSTGRES_DB=getiajob
DB_PORT=5432
# Uniquement pour lancer le code hors Docker (dans Docker, l'URL est fixée par docker-compose) :
# DATABASE_URL=postgresql+psycopg://getiajob:getiajob@localhost:5432/getiajob

# --- Ollama ---
# Sur Mac, Docker n'a pas accès au GPU : lance Ollama sur la machine hôte (app native)
# et garde host.docker.internal. Pour utiliser le conteneur Ollama : http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b
LLM_NUM_CTX=8192
# Appels LLM simultanés pendant l'analyse d'un CV (cf. OLLAMA_NUM_PARALLEL)
LLM_CONCURRENCY=2
# Durée maximale (s) d'un appel au LLM ; au-delà, l'étape de l'analyse est abandonnée
LLM_TIMEOUT=900
# Longueur maximale d'une réponse du LLM (tokens)
LLM_MAX_TOKENS=6144
# Serveur sans GPU (VPS) : préférer LLM_MODEL=qwen2.5:3b, LLM_NUM_CTX=8192, LLM_CONCURRENCY=1
#   (contexte = CV ~3 000 tokens + réponse jusqu'à ~5 000 : ne pas descendre sous 8192)
# --- LLM distant (facultatif) : API compatible OpenAI, ex. OVHcloud AI Endpoints ---
# Les embeddings restent sur Ollama (EMBEDDING_MODEL) ; LLM_NUM_CTX ne s'applique qu'à Ollama.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# LLM_MODEL=Olala-v1.0-mini-7A1B
# Indispensable : sans clé, OVH n'accepte qu'1 requête par an, par modèle et par IP.
# Clé à créer dans Public Cloud → AI & Machine Learning → AI Endpoints (Olala reste gratuit).
# LLM_API_KEY=
# json_schema (schéma imposé par l'API) ou json_object (si le modèle refuse json_schema)
# LLM_JSON_MODE=json_schema
# LLM_MAX_RETRIES=3
# Effort de raisonnement (modèles qui raisonnent, ex. Olala) : none, minimal, low, medium, high…
# Vide = défaut du modèle ; « low » accélère nettement l'extraction.
# LLM_REASONING_EFFORT=low
# Prix par million de tokens (envoyés / générés) pour le coût estimé (Admin › Supervision › Consommation IA).
# Vide = coût non calculé (modèle gratuit comme Olala, ou Ollama).
# LLM_PRICE_INPUT=0.79
# LLM_PRICE_OUTPUT=0.79
# LLM_PRICE_CURRENCY=€
# Configurations de LLM, au choix dans Admin › Paramètres : un bloc LLM_PROFILES__<NOM>__<CHAMP> par
# configuration. Champs : LABEL, PROVIDER (ollama | openai), MODEL, BASE_URL, API_KEY, JSON_MODE,
# REASONING_EFFORT, NUM_CTX (Ollama), PRICE_INPUT, PRICE_OUTPUT (pour Ollama : API_KEY et
# REASONING_EFFORT ignorés). Après modification : scripts/restart.sh
# La configuration « default » (utilisée tant qu'aucune autre n'est choisie) est le bloc DEFAULT s'il
# est déclaré, en entier (il remplace alors LLM_PROVIDER, LLM_MODEL…), sinon les variables LLM_*.
# Le bloc DEFAULT porte aussi les réglages communs, prioritaires sur les variables ci-dessus :
# BASE_URL (s'il est sur Ollama) → OLLAMA_BASE_URL, NUM_CTX → LLM_NUM_CTX, EMBEDDING_MODEL et
# EMBEDDING_DIM (lus dans DEFAULT seulement : les embeddings sont communs à toutes les configurations).
# Les autres configurations Ollama prennent ces BASE_URL et NUM_CTX par défaut.
# LLM_PROFILES__DEFAULT__LABEL=Qwen 2.5 7B (Ollama, local)
# LLM_PROFILES__DEFAULT__PROVIDER=ollama
# LLM_PROFILES__DEFAULT__MODEL=qwen2.5:7b
# LLM_PROFILES__DEFAULT__BASE_URL=http://host.docker.internal:11434
# LLM_PROFILES__DEFAULT__NUM_CTX=16384   # CV long avec qwen2.5:7b : 8192 fait perdre des expériences
# LLM_PROFILES__DEFAULT__EMBEDDING_MODEL=nomic-embed-text
# LLM_PROFILES__DEFAULT__EMBEDDING_DIM=768
# LLM_PROFILES__DEFAULT__PRICE_INPUT=0
# LLM_PROFILES__DEFAULT__PRICE_OUTPUT=0
# LLM_PROFILES__GEMMA4__LABEL=Gemma 4 12B (Ollama, local)
# LLM_PROFILES__GEMMA4__PROVIDER=ollama
# LLM_PROFILES__GEMMA4__MODEL=gemma4:12b
# LLM_PROFILES__OLALA__LABEL=Olala (OVHcloud, gratuit)
# LLM_PROFILES__OLALA__PROVIDER=openai
# LLM_PROFILES__OLALA__MODEL=Olala-v1.0-mini-7A1B
# LLM_PROFILES__OLALA__BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# LLM_PROFILES__OLALA__API_KEY=
# LLM_PROFILES__OLALA__REASONING_EFFORT=low
# LLM_PROFILES__OLALA__PRICE_INPUT=0
# LLM_PROFILES__OLALA__PRICE_OUTPUT=0
# Avec un modèle distant rapide, LLM_CONCURRENCY peut monter à 4 (selon la limite de la clé).
EMBEDDING_MODEL=nomic-embed-text
# Doit correspondre à la dimension du modèle d'embedding (nomic-embed-text = 768)
EMBEDDING_DIM=768

# --- Scraping ---
LINKEDIN_REQUEST_DELAY=2.5

# --- Sources officielles d'offres (facultatives : actives dès que les clés sont renseignées) ---
# France Travail : créer une application sur https://francetravail.io (API « Offres d'emploi v2 »)
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=
# Adzuna : clé gratuite sur https://developer.adzuna.com (quota journalier limité)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Alertes e-mail (APEC…) lues en IMAP, en lecture seule ---
# Boîte commune où les utilisateurs transfèrent leurs alertes APEC (depuis l'adresse de leur compte).
# Gmail : imap.gmail.com + mot de passe d'application (Compte Google › Sécurité, validation en 2 étapes).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Supprime (corbeille) les alertes importées après traitement ; false = lecture seule
MAIL_DELETE_PROCESSED=true

LOG_LEVEL=INFO

# --- Interface web ---
WEB_PORT=8501
# Mettre false sur une instance publique pour fermer la création de comptes
ALLOW_SIGNUP=true
# Adhésion sur invitation : demande d'accès validée par un administrateur, code envoyé par e-mail
INVITE_ONLY=true
# Validité (jours) d'une invitation
INVITATION_DAYS=14
# Adresse publique de l'application, pour le lien des e-mails d'invitation (ex. https://getiajob.mondomaine.fr).
# Vide : adresse de la page d'où l'administrateur envoie l'invitation
PUBLIC_URL=
# Durée (jours) de la connexion « rester connecté »
SESSION_DAYS=30
# Mise en ligne (profil prod / Caddy) : nom de domaine pointant vers le serveur
# DOMAIN=getiajob.mondomaine.fr

# --- Supervision : notifications e-mail des administrateurs (getiajob monitor) ---
# SMTP vide = déduit de la boîte IMAP (imap.gmail.com -> smtp.gmail.com, mêmes identifiants)
ALERTS_ENABLED=true
ALERT_EMAILS=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
